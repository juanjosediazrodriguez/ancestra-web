# Copia este archivo como .env y completa los valores.
# Ninguno es secreto: el dataset de Sanity es público (solo lectura) y el número de WhatsApp sale en la página.

# Sanity — ID del proyecto (sanity.io/manage). Si se deja vacío, el sitio usa datos de muestra.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# WhatsApp de Ancestra: código de país + número, sin "+", sin espacios. Ej.: 573001234567
PUBLIC_WHATSAPP_NUMBER=
